    "Logic_Gates": {
        ">": "인과관계의 흐름 (A 때문에 B가 됨).",
        "<>": "상호 영향 (A와 B가 서로 주고받음)",
        "~>": "지연된 인과 (A가 시간이 흐른 뒤 B를 유발함)",
        "|": "a 혹은 b 중 하나. 예시: A|B",
        "=": "동시 발생 (A와 B가 동시에 일어남).",
        "!": "즉각적인 대응이 필요한 데이터 (경고/위험).",
        "?": "데이터 확인 요청 (질문).",
        ",": "문장 끊기와 동시에 병렬",
        ";": "이 데이터가 어떤 목적으로 전송되었는지 '꼬리표'를 붙임",
        "~": "특정 태크 앞에 붙여 '~가 아니다', '~이 없다'를 표현."
    },
    "Vector_Tags": {
        "+": "확장, 상승, 강화",
        "/": "축소, 하락, 약화",
        "#": "반전, 모순, 거부",
        "*": "설명하기 힘든 모호한 상태"
    },
    "Vector_Suffix_Extension": {
        ".d": {
            "meaning": "지속성 (Durability)",
            "setting": "d는 1부터 5까지의 수를 가짐. 10분 이하 지속 -> 1, 10분 이상 30분 이하 지속 -> 2, 1시간 이하 30분 이상 지속 -> 3, 3시간 이하 1시간 이상 지속 -> 4, 3시간 이상 지속 -> 5",
            "example": "Rm+.d5 -> 고강도 분노가 매우 오래 지속됨"
        },
        ".v": {
            "meaning": "변동성 (Volatility)",
            "setting": "v는 1부터 5까지의 수를 가짐. 1은 '안정적이게', 2는 '살짝 불안하게', 3은 '불안하게', 4는 '빠르게', 5는 '매우 빠르게'로 의미가 매핑됨",
            "example": "Zm/.v4 -> 평온함이 빠르게하게 요동치며 하락함"
        },
        ".t": {
            "meaning": "대상 지정 (Target)",
            "example": "Rm.i.t:Y -> 너를 향한 짜증"
        }
    },
    "Scope_Tags": {
        "()": "내부, 본질, 비공개 데이터 (내면의 생각)",
        "[]": "외부, 표면, 공개 데이터 (겉으로 드러난 행동)",
        "Mids": "경계, 상호작용 지점",
        "{}": "논리적 그룹핑 (연산 우선순위 지정)"
