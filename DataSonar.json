    "fitr": {
        "type": "filter tag",
        "setting": "이 인공어의 다른 품사들을 묶어서 하나의 변수로 만들고 그 변수가 필터 역할을 한다",
        "standard_library": {
            "@Burnout": "{T:flow + Kg:High + (Rm+)}",
            "@Flow": "{T:flow + Lg.c + (Zm.f+)}"
        }
    },
    "Humanity_Tags": {
        "Ht": "논리적 근거는 없는 데 그냥 그렇게 느껴지는 것.",
        "St": "너의 상태를 나도 함께 느끼겠다",
        "Lt": "가능성과 상상"
    },
    "Primary_Categories": {
        "Vg": {
            "meaning": "결핍/필요",
