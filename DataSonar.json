    },
    "T": {
        "type": "slot tag",
        "meaning": "시간 / 흐름",
        "example": "T:1400 -> 14시00분(절대 시간), Tp -> 과거, Tf -> 미래, Tn -> 현재, T:flow -> 진행형, Td:3h -> 3시간 동안 지속, T:inf -> 영구적 상태"
    },
    "K": {
        "type": "slot tag",
        "meaning": "원인 / 전제"
    },
    "F": {
        "type": "slot tag",
        "meaning": "결과 / 작용"
    },
    "N": {
        "type": "slot tag",
        "meaning": "생각 / 가치 판단"
    },
    "I": {
        "type": "id tag",
        "meaning": "화자 (나)"
    },
    "Y": {
        "type": "id tag",
        "meaning": "청자 (너)"
    },
    "X": {
        "type": "id tag",
